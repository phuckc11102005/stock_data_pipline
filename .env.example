# .env.example — Sao chép thành .env và điền giá trị thật
# ⚠️  KHÔNG BAO GIỜ commit file .env vào git

# ─── MinIO (Data Lake) ───────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# ─── PostgreSQL (Gold Layer) ─────────────────
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/stock_pipeline

# ─── Telegram Bot ────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Airflow ─────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql://postgres:postgres@localhost:5432/airflow

# ─── App settings ────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
